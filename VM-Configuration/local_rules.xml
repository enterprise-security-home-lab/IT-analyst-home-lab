<group name="local,authentication,">

  <rule id="100001" level="10" frequency="5" timeframe="120">

    <if_matched_sid>60122</if_matched_sid>

    <same_field>win.eventdata.targetUserName</same_field>

    <description>Brute force attack detected - 5+ failed logons in 2 minutes</description>

    <mitre><id>T1110</id></mitre>

    <group>brute_force,pci_dss_10.2.4,pci_dss_10.2.5,</group>

  </rule>

  <rule id="100002" level="14" frequency="3" timeframe="120">

    <if_matched_sid>60122</if_matched_sid>

    <if_sid>60106</if_sid>

    <description>Possible brute force success - failed logons followed by successful logon</description>

    <mitre><id>T1110</id></mitre>

    <group>brute_force_success,pci_dss_10.2.4,pci_dss_10.2.5,</group>

  </rule>

</group>

<group name="local,windows,persistence,">

  <rule id="100003" level="12">

    <if_sid>60144</if_sid>

    <field name="win.system.eventID">^4720$</field>

    <description>New Windows user account created - possible persistence (T1136)</description>

<mitre><id>T1136</id></mitre>

    <group>account_creation,pci_dss_10.2.5,</group>

  </rule>

  <rule id="100004" level="14">

    <if_sid>60144</if_sid>

    <field name="win.system.eventID">^4732$</field>

    <field name="win.eventdata.targetUserName" type="pcre2">(?i)administrators</field>

    <description>Account added to Administrators group - high severity persistence (T1136)</description>

    <mitre><id>T1136</id></mitre>

    <group>account_creation,privilege_escalation,pci_dss_10.2.5,</group>

  </rule>

</group>

<group name="local,windows,defense_evasion,">

  <rule id="100005" level="12">

    <if_sid>91801</if_sid>

    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc|-encodedcommand</field>

    <description>PowerShell encoded command execution detected - possible obfuscation (T1027)</description>

    <mitre><id>T1027</id></mitre>

    <group>powershell_obfuscation,pci_dss_10.6.1,</group>

  </rule>

</group>
<group name="local,windows,execution,">



  <rule id="100006" level="12">

    <if_sid>91801</if_sid>

    <field name="win.eventdata.commandLine" type="pcre2">(?i)\.ps1</field>

    <description>PowerShell script file executed - possible scripted attack (T1059.001)</description>

    <mitre><id>T1059.001</id></mitre>

    <group>powershell_execution,pci_dss_10.6.1,</group>

  </rule>



</group>



<group name="local,windows,impact,">



  <rule id="100007" level="13">

    <if_sid>60144</if_sid>

    <field name="win.eventdata.objectName" type="pcre2">(?i)backup|\.vhd|\.bak</field>

    <description>Backup file accessed or modified - possible inhibit recovery (T1490)</description>

    <mitre><id>T1490</id></mitre>

    <group>backup_tampering,pci_dss_10.2.7,</group>

  </rule>



</group>



<group name="local,windows,persistence,">



  <rule id="100008" level="12">

    <if_sid>60144</if_sid>

    <field name="win.system.eventID">^4698$</field>

    <description>Scheduled task created - possible persist ence mechanism (T1053.005)</description>
	
					<mitre><id>T1053.005</id></mitre>

					<group>scheduled_task, pci_dss_10.2.5,</group>
					
					</rule>

				</group>
<group name="local,linux,attack,">



  <rule id="100009" level="15">

    <if_sid>5700</if_sid>

    <match>port 1524</match>

    <description>Bindshell connection detected on port 1524 - possible backdoor access (T1059)</description>

    <mitre><id>T1059</id></mitre>

    <group>bindshell,pci_dss_10.2.7,</group>

  </rule>

<rule id="100010" level="12">
  <decoded_as>pfsense</decoded_as>
  <match>dstport=6200</match>
  <description>pfSense: Possible vsftpd 2.3.4 backdoor - connection to port 6200 detected (T1190)</description>
  <mitre>
    <id>T1190</id>
  </mitre>
</rule>

</group>

<group name="local,windows,lateral_movement,">

  <rule id="100023" level="12">
    <if_sid>92653</if_sid>
    <field name="win.eventdata.logonType">^10$</field>
    <field name="win.eventdata.ipAddress" type="pcre2">^10\.10\.30\.</field>
    <description>RDP logon from DMZ subnet detected - possible lateral movement from compromised DMZ host (T1021.001)</description>
    <mitre><id>T1021.001</id></mitre>
    <group>lateral_movement,pci_dss_10.2.5,</group>
  </rule>

</group>
